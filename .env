# Screen-share config, resolved at build time (see src/webrtc/config.ts).
# Vite only exposes VITE_-prefixed vars to client code, hence the prefix.

# WHIP publish endpoint (path segment is the MediaMTX stream name).
VITE_WHIP_ENDPOINT_URL=http://192.168.20.38:8889/room1/whip

# Screen content doesn't need 30/60fps to read; capping this is the single biggest CPU win.
VITE_MAX_FRAME_RATE=15
VITE_MAX_WIDTH=1280
VITE_MAX_HEIGHT=720

# Keeps the encoder from chasing full quality on a busy screen; plenty for 1280x720@15fps.
VITE_MAX_VIDEO_BITRATE=2500000
